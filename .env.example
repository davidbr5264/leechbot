# From https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=your_api_hash

# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Your numeric Telegram user ID (get it from @userinfobot). Only this user can use the bot.
OWNER_ID=123456789

# Use a disk-backed path. /tmp is often tmpfs (RAM-backed) and would eat your memory.
DOWNLOAD_DIR=/var/tmp/leechbot

# Size of one Telegram upload (limit is 2000 MiB for non-Premium); bigger files are split.
MAX_FILE_SIZE_MB=1990

# Largest total download to accept before splitting.
MAX_DOWNLOAD_MB=8000

# Refuse to start a download if free disk would drop below this.
MIN_FREE_MB=300

# Optional: Netscape-format cookies for age-gated / member-only YouTube videos.
# COOKIES_FILE=/opt/leechbot/cookies.txt
